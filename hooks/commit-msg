#!/bin/bash
COMMIT_MSG=$(cat "$1")

# Prüft auf korrektes Commit-Format
if ! echo "$COMMIT_MSG" | grep -Eq "^(AUFGABE|NEUE FUNKTION|FEHLERBEHEBUNG|CODE-VERBESSERUNG): .+"; then
    echo " Ungültiges Commit-Format! Bitte verwenden: 'AUFGABE|NEUE FUNKTION|FEHLERBEHEBUNG|CODE-VERBESSERUNG: Beschreibung'"
    exit 1
fi

echo "Commit-Format korrekt."
exit 0

