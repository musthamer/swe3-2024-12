<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
  version="5.0">

<display-name>SWE 3 Demo App</display-name>

<listener>
  <listener-class>hbv.web.MyContextListener</listener-class>
</listener>

<servlet>
  <servlet-name>loginServlet</servlet-name>
  <servlet-class>hbv.web.LoginServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>loginServlet</servlet-name>
  <url-pattern>/login</url-pattern>
</servlet-mapping>

<servlet>
  <servlet-name>logoutServlet</servlet-name>
  <servlet-class>hbv.web.LogoutServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>logoutServlet</servlet-name>
  <url-pattern>/logout</url-pattern>
</servlet-mapping>

<welcome-file-list>
  <welcome-file>index.html</welcome-file>
</welcome-file-list>

<error-page>
  <error-code>404</error-code>
  <location>/error-404.html</location>
</error-page>

<!-- Activate Servlet -->
<servlet>
  <servlet-name>activateServlet</servlet-name>
  <servlet-class>hbv.web.ActivateServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>activateServlet</servlet-name>
  <url-pattern>/activate</url-pattern>
</servlet-mapping>

<!-- PDF Download Servlet -->
<servlet>
  <servlet-name>bookingPDFServlet</servlet-name>
  <servlet-class>hbv.web.BookingPDFServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>bookingPDFServlet</servlet-name>
  <url-pattern>/booking-pdf</url-pattern>
</servlet-mapping>

<!-- Reset Password Servlet -->
<servlet>
  <servlet-name>resetPasswordServlet</servlet-name>
  <servlet-class>hbv.web.ResetPasswordServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>resetPasswordServlet</servlet-name>
  <url-pattern>/reset-password</url-pattern>
</servlet-mapping>

<!-- Ergänzung zum API-Servlet -->
<servlet>
  <servlet-name>apiServlet</servlet-name>
  <servlet-class>hbv.web.ApiServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>apiServlet</servlet-name>
  <url-pattern>/api/*</url-pattern>
</servlet-mapping>

<!-- Register Servlet -->
<servlet>
  <servlet-name>registerServlet</servlet-name>
  <servlet-class>hbv.web.RegisterServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>registerServlet</servlet-name>
  <url-pattern>/register</url-pattern>
</servlet-mapping>

<!-- Admin Servlet -->
<servlet>
  <servlet-name>adminServlet</servlet-name>
  <servlet-class>hbv.web.AdminServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>adminServlet</servlet-name>
  <url-pattern>/api/admin/*</url-pattern>
</servlet-mapping>

<!-- Forgot Password Servlet -->
<servlet>
  <servlet-name>forgotPasswordServlet</servlet-name>
  <servlet-class>hbv.web.ForgotPasswordServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>forgotPasswordServlet</servlet-name>
  <url-pattern>/forgot-password</url-pattern>
</servlet-mapping>

<!-- Email Viewer Servlet -->
<servlet>
  <servlet-name>emailViewerServlet</servlet-name>
  <servlet-class>hbv.web.EmailViewerServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>emailViewerServlet</servlet-name>
  <url-pattern>/emails</url-pattern>
</servlet-mapping>

<!-- AdminDashboardRedirectServlet für die Weiterleitung -->
<servlet>
    <servlet-name>adminDashboardRedirectServlet</servlet-name>
    <servlet-class>hbv.web.AdminDashboardRedirectServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>adminDashboardRedirectServlet</servlet-name>
    <url-pattern>/admin</url-pattern>
</servlet-mapping>

<!-- Admin Auth Filter -->
<filter>
  <filter-name>adminAuthFilter</filter-name>
  <filter-class>hbv.web.filter.AdminAuthFilter</filter-class>
</filter>
<filter-mapping>
  <filter-name>adminAuthFilter</filter-name>
  <url-pattern>/admin/*</url-pattern>
</filter-mapping>
<filter-mapping>
  <filter-name>adminAuthFilter</filter-name>
  <url-pattern>/api/admin/*</url-pattern>
</filter-mapping>

<context-param>
  <param-name>redispassword</param-name>
  <param-value>REDISPASSWORD</param-value>
</context-param>
<context-param>
  <param-name>redisserver</param-name>
  <param-value>REDISSERVER</param-value>
</context-param>

<!-- Konfiguration für die E-Mail-Links -->
<context-param>
  <param-name>baseurl</param-name>
  <param-value>BASEURL</param-value>
</context-param>
<context-param>
  <param-name>webapp</param-name>
  <param-value>WEBAPP</param-value>
</context-param>

</web-app>  
