<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>Impftest</display-name>
  <welcome-file-list>
    <welcome-file>static/index.html</welcome-file>
  </welcome-file-list>

  <!-- LoginServlet -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>hbv.web.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <!-- RegistrationServlet (ohne Impfzentrum-Option) -->
  <servlet>
    <servlet-name>RegistrationServlet</servlet-name>
    <servlet-class>hbv.web.servlet.RegistrationServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RegistrationServlet</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <!-- LogoutServlet -->
  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>hbv.web.servlet.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- User Dashboard -->
  <servlet>
    <servlet-name>DashboardServlet</servlet-name>
    <servlet-class>hbv.web.servlet.DashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DashboardServlet</servlet-name>
    <url-pattern>/dashboard</url-pattern>
  </servlet-mapping>

  <!-- Appointment, Cancel, Confirmation -->
  <servlet>
    <servlet-name>AppointmentServlet</servlet-name>
    <servlet-class>hbv.web.servlet.AppointmentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CancelServlet</servlet-name>
    <servlet-class>hbv.web.servlet.CancelServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CancelServlet</servlet-name>
    <url-pattern>/cancel</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ConfirmationServlet</servlet-name>
    <servlet-class>hbv.web.servlet.ConfirmationServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ConfirmationServlet</servlet-name>
    <url-pattern>/confirmation</url-pattern>
  </servlet-mapping>

  <!-- Center Dashboard -->
  <servlet>
    <servlet-name>CenterDashboardServlet</servlet-name>
    <servlet-class>hbv.web.servlet.CenterDashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CenterDashboardServlet</servlet-name>
    <url-pattern>/centerDashboard</url-pattern>
  </servlet-mapping>

  <!-- Admin Dashboard -->
  <servlet>
    <servlet-name>AdminDashboardServlet</servlet-name>
    <servlet-class>hbv.web.servlet.AdminDashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminDashboardServlet</servlet-name>
    <url-pattern>/adminDashboard</url-pattern>
  </servlet-mapping>

  <!-- CenterServlet zum Anlegen neuer Zentren (mit Header/CSS) -->
  <servlet>
    <servlet-name>CenterServlet</servlet-name>
    <servlet-class>hbv.web.servlet.CenterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CenterServlet</servlet-name>
    <url-pattern>/center</url-pattern>
  </servlet-mapping>

  <!-- DoseServlet zum Anlegen neuer Impfdosen -->
  <servlet>
    <servlet-name>DoseServlet</servlet-name>
    <servlet-class>hbv.web.servlet.DoseServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DoseServlet</servlet-name>
    <url-pattern>/dose</url-pattern>
  </servlet-mapping>

  <!-- Listener und Filter -->
  <listener>
    <listener-class>hbv.web.servlet.MyContextListener</listener-class>
  </listener>

  <filter>
    <filter-name>myfilter</filter-name>
    <filter-class>hbv.web.servlet.MyFilter</filter-class>
    <async-supported>true</async-supported>
  </filter>
  <filter-mapping>
    <filter-name>myfilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
</web-app>
